{
  "name": "surg-d",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Surgical D ward routine and task management",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:migrate:prod": "npm run db:migrate:prod -w server",
    "db:seed:prod": "npm run db:seed:prod -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
