PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=surgd
DB_PASSWORD=surgd
DB_NAME=surg_d
# true for cloud MySQL such as TiDB Cloud
DB_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173

# Initial super admin created by `npm run db:seed`
ADMIN_EMPLOYEE_CODE=1
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@surg-d.local
ADMIN_PASSWORD=ChangeMe123!

# Admin "switch user" for testing. Defaults to on, except when NODE_ENV=production.
# ALLOW_IMPERSONATION=false

# Hospital patients/beds API (cached; it takes ~10 s to respond)
BEDS_API_URL=http://182.188.28.220:8034/api/Patient/GetDoctorAdmittedPatients
BEDS_CACHE_SECONDS=300
# Bed codes or groups to hide (ORHB also hides ORHB-1, ORHB-5, …)
BEDS_EXCLUDE=ORHB
