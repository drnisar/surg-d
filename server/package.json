{
  "name": "@surg-d/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:migrate:prod": "node --env-file=.env.production scripts/migrate.js",
    "db:seed:prod": "node --env-file=.env.production scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@surg-d/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  }
}
